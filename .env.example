
# ==============================================================================
# VeloPulse Environment Variables Template
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="VeloPulse"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-32-byte-hex-string-for-production

# Server Configuration
HOST=0.0.0.0
PORT=8000

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=velopulse_user
POSTGRES_PASSWORD=velopulse_password
POSTGRES_DB=velopulse_db
POSTGRES_ECHO=false

# Redis Configuration (Broker & Cache)
REDIS_URL=redis://localhost:6379/0

# Strava API Credentials (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_VERIFY_TOKEN=your_secure_webhook_verification_token
STRAVA_WEBHOOK_CALLBACK_URL=https://your-public-domain.ngrok-free.app/api/v1/webhooks/strava

# Telegram Bot (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Open-Meteo Configuration
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
